{{!-- Error Page Template --}}

<div class="error-container">
    {{{icon "triangle-alert" class="error-icon"}}}
    <h1>{{title}}</h1>
    <p class="error-message">{{message}}</p>
    
    {{#if error}}
        <div class="error-details">
            <pre>{{error}}</pre>
        </div>
    {{/if}}
    
    <div class="error-actions">
        <a href="/" class="btn-primary">{{{icon "home" class="icon-sm"}}} Go Home</a>
        <button onclick="window.history.back()" class="btn-secondary">{{{icon "arrow-left" class="icon-sm"}}} Go Back</button>
    </div>
</div>
