    </a>
    <a href="/workflow" class="topbar-nav-link {{#if (eq currentPage 'workflow')}}is-active{{/if}}" {{#if (eq currentPage 'workflow')}}aria-current="page"{{/if}}>
        {{{icon "workflow" class="topbar-nav-icon"}}}
        <span>Workflow</span>
    </a>
    <a href="/linear-notes" class="topbar-nav-link {{#if (eq currentPage 'linear-notes')}}is-active{{/if}}" {{#if (eq currentPage 'linear-notes')}}aria-current="page"{{/if}}>
