<div class="stats-grid">
    {{#each stats}}
    <div class="stat-card">
        {{#if this.icon}}
        <div class="stat-icon" aria-hidden="true">{{this.icon}}</div>
        {{/if}}
        <div class="stat-value">{{this.value}}</div>
        <div class="stat-label">{{this.label}}</div>
    </div>
    {{/each}}
</div>
