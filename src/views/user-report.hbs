{{!-- User Report Dashboard Template --}}

{{!-- Back Link --}}
<a href="/submissions" class="back-link">{{{icon "arrow-left" class="icon-sm"}}} Back to All Submissions</a>

{{!-- User Header --}}
<div class="user-header-card">
    <div class="user-profile">
        {{#if avatarUrl}}
            <img src="{{avatarUrl}}" alt="{{userName}}" class="user-avatar-large" />
        {{else}}
            <div class="user-avatar-large">{{userInitial userName}}</div>
        {{/if}}
        <div class="user-info-main">
            <h1>{{userName}}</h1>
            <p class="user-period">{{periodLabel}}</p>
        </div>
    </div>
    
    {{!-- Performance Badge --}}
    <div class="performance-badge {{riskLevel}}">
        <div class="score">{{performanceScore}}</div>
        <div class="label">Performance Score</div>
        <div class="trend {{velocityTrend}}">
            {{#if (eq velocityTrend 'up')}}{{{icon "trending-up" class="icon-sm"}}}{{else if (eq velocityTrend 'down')}}{{{icon "trending-down" class="icon-sm"}}}{{else}}{{{icon "move-right" class="icon-sm"}}}{{/if}}
            {{velocityTrend}}
        </div>
    </div>

    <div class="user-actions">
        <a href="/export/user/{{userId}}" class="btn btn-primary">{{{icon "download" class="icon-sm"}}} Export CSV</a>
    </div>
</div>

{{!-- Stats Grid --}}
<div class="stats-grid">
    <div class="stat-card">
        {{{icon "chart-column" class="stat-icon"}}}
        <div class="stat-value">{{totalSubmissions}}</div>
        <div class="stat-label">Total Submissions</div>
    </div>
    <div class="stat-card">
        {{{icon "clipboard-list" class="stat-icon"}}}
        <div class="stat-value">{{totalTasks}}</div>
        <div class="stat-label">Tasks Tracked</div>
    </div>
    <div class="stat-card">
        {{{icon "zap" class="stat-icon"}}}
        <div class="stat-value">{{avgTasksPerDay}}</div>
        <div class="stat-label">Avg Tasks/Day</div>
    </div>
    <div class="stat-card {{#if (gt blockerCount 0)}}warning{{/if}}">
        {{{icon "triangle-alert" class="stat-icon"}}}
        <div class="stat-value">{{blockerCount}}</div>
        <div class="stat-label">Days with Blockers</div>
    </div>
</div>

{{!-- Performance Radar --}}
<div class="performance-radar-section">
    <div class="section-heading">
        <div>
            <h3>{{{icon "target" class="icon-md"}}} Performance Radar</h3>
            <p>Consistency, engagement, velocity, and blocker-free rate</p>
        </div>
    </div>
    <div class="radar-chart-container">
        <canvas id="performanceRadar"></canvas>
    </div>
</div>

{{!-- Contribution Graph --}}
<div class="contribution-section">
    <h3>{{{icon "calendar-days" class="icon-md"}}} Activity Overview</h3>
    {{{contributionGraphHTML}}}
</div>

{{!-- Day Off History --}}
{{#if (gt dayOffEntries.length 0)}}
<div class="ooo-section">
    <div class="ooo-header">
        <h3>{{{icon "plane" class="icon-md"}}} Day Off History</h3>
        <div class="ooo-filters">
            {{#each oooFilters}}
                <a href="{{this.url}}" class="ooo-filter-btn {{#if this.active}}active{{/if}}">{{this.label}}</a>
            {{/each}}
        </div>
    </div>
    <div class="ooo-list">
        {{#each dayOffEntries}}
            <div class="ooo-item">
                <span class="ooo-date">{{formatDate this.date 'MMM d, yyyy'}}</span>
                <span class="ooo-reason">{{or this.dayOffReason 'Day Off'}}</span>
            </div>
        {{/each}}
    </div>
</div>
{{/if}}

{{!-- Time Period Filter --}}
<div class="filters">
    <span class="filter-label">{{{icon "calendar-days" class="icon-sm"}}} Time Period:</span>
    <a href="/user/{{userId}}?period=week" class="filter-btn {{#if (eq period 'week')}}active{{/if}}">Last 7 Days</a>
    <a href="/user/{{userId}}?period=month" class="filter-btn {{#if (eq period 'month')}}active{{/if}}">This Month</a>
    <a href="/user/{{userId}}?period=all" class="filter-btn {{#if (eq period 'all')}}active{{/if}}">All Time</a>
</div>

{{!-- Standup History --}}
<div class="content">
    {{#each standups}}
        <div class="standup-card {{#if this.hasBlocker}}has-blocker{{/if}} {{#if this.isDayOff}}day-off-card{{/if}}">
            <div class="date-header">
                <div class="date-title">
                    {{formatDate this.date 'EEEE, MMMM d, yyyy'}}
                    {{#if this.hasBlocker}}<span class="blocker-badge">HAS BLOCKERS</span>{{/if}}
                    {{#if this.isDayOff}}<span class="dayoff-badge">DAY OFF</span>{{/if}}
                </div>
                <div class="timestamp">Submitted at {{formatDate this.createdAt 'h:mm a'}}</div>
            </div>
            
            <div class="section">
                <div class="section-label">{{{icon "clock" class="icon-sm"}}} What I Did Yesterday</div>
                <div class="section-content">{{this.yesterday}}</div>
            </div>
            
            <div class="section">
                <div class="section-label">{{{icon "calendar-check" class="icon-sm"}}} What I'll Do Today</div>
                <div class="section-content">{{this.today}}</div>
            </div>
            
            {{#if this.hasBlocker}}
            <div class="section">
                <div class="section-label">{{{icon "triangle-alert" class="icon-sm"}}} Blockers</div>
                <div class="section-content blocker-content">{{this.blockers}}</div>
            </div>
            {{/if}}
            
            {{#if this.notes}}
            <div class="section">
                <div class="section-label">{{{icon "notebook-pen" class="icon-sm"}}} Notes</div>
                <div class="section-content notes-content">{{this.notes}}</div>
            </div>
            {{/if}}
            
            {{#if this.isDayOff}}
            <div class="section">
                <div class="section-label">{{{icon "plane" class="icon-sm"}}} Day Off</div>
                <div class="section-content dayoff-content">{{or this.dayOffReason 'Marked as out of office'}}</div>
            </div>
            {{/if}}
        </div>
    {{/each}}
</div>
